# SmythOS SRE Enhanced - Variables de Entorno de Ejemplo
# Copia este archivo a .env y configura tus API keys

# === CONFIGURACIÓN PRINCIPAL ===
NODE_ENV=production
PORT=8000
API_VERSION=1.0.0

# === OPENAI ===
OPENAI_API_KEY=tu_openai_api_key_aqui
OPENAI_API_MODEL=gpt-5-nano
OPENAI_BASE_URL=https://api.openai.com/v1

# === ANTHROPIC (Claude) ===
ANTHROPIC_API_KEY=tu_anthropic_api_key_aqui
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# === TOGETHER AI ===
TOGETHER_API_KEY=tu_together_api_key_aqui
TOGETHER_BASE_URL=https://api.together.xyz/v1

# === GROQ ===
GROQ_API_KEY=tu_groq_api_key_aqui
GROQ_BASE_URL=https://api.groq.com/openai/v1

# === DEEPINFRA ===
DEEPINFRA_API_KEY=tu_deepinfra_api_key_aqui
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# === DEEPSEEK ===
DEEPSEEK_API_KEY=tu_deepseek_api_key_aqui
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# === MISTRAL ===
MISTRAL_API_KEY=tu_mistral_api_key_aqui
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# === COHERE ===
COHERE_API_KEY=tu_cohere_api_key_aqui
COHERE_BASE_URL=https://api.cohere.ai/v1

# === OPENROUTER ===
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === YOU.COM ===
YOU_API_KEY=tu_you_api_key_aqui
YOUR_SITE_URL=https://tu-sitio.com

# === TAVILY (Web Search) ===
TAVILY_API_KEY=tu_tavily_api_key_aqui

# === CONFIGURACIÓN DE RATE LIMITS ===
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# === CONFIGURACIÓN DE LOGGING ===
LOG_LEVEL=info
LOG_FILE=/root/logs/sre-deploy.log

# === CONFIGURACIÓN DE SEGURIDAD ===
JWT_SECRET=tu_jwt_secret_aqui
SESSION_SECRET=tu_session_secret_aqui
CORS_ORIGIN=*
